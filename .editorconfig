root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Windows command scripts keep CRLF (.gitattributes).
[*.{bat,cmd}]
end_of_line = crlf

[*.rs]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,mjs,json,yml,yaml}]
indent_style = space
indent_size = 2

# Generated by tauri-specta with tabs; never edited by hand.
[ui/src/bindings.ts]
indent_style = tab
trim_trailing_whitespace = false

# Vendored upstream code and recorded spike output stay byte-for-byte as they are (the upstream
# lancedb LICENSE has no final newline; some result files keep a BOM).
[patches/**]
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[spikes/*/results/**]
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
