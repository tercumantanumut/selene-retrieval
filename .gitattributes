# Line endings: LF in the repository and in every checkout. rustfmt.toml sets
# newline_style = "Unix", and Windows checkouts default to core.autocrlf = true.
* text=auto eol=lf

# Windows command scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary: never converted or diffed as text.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
*.onnx binary
*.bin binary
*.dll binary
*.exe binary
*.msi binary
*.woff binary
*.woff2 binary
*.ttf binary
*.wav binary
*.mp3 binary
