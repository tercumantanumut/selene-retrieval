{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selene Retrieval",
  "mainBinaryName": "sr-app",
  "version": "0.1.0",
  "identifier": "ai.selene.retrieval",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui", "wait": false },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Selene Retrieval",
        "width": 920,
        "height": 700,
        "minWidth": 640,
        "minHeight": 540,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Selene",
    "shortDescription": "Search your folders from Claude and other AI apps",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://updates.invalid/selene-retrieval/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "M2A-PLACEHOLDER-REPLACE-WITH-MINISIGN-PUBKEY-AT-SIGNING",
      "windows": { "installMode": "passive" }
    }
  }
}
